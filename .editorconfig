root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx,mjs,cjs,json,yml,yaml,css,scss,html,mdx,md}]
indent_size = 2

[*.{rb}]
indent_size = 2

[*.{kt,java}]
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 100

[Makefile]
indent_style = tab
