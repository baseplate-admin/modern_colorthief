{
  "plugins": ["typescript"],
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    ".astro/**",
    "public/wasm/**",
    "public/wasm-webgpu/**"
  ],
  "rules": {
    "no-console": [
      "error",
      {
        "allow": ["warn", "error"]
      }
    ],
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "typescript/no-explicit-any": "error"
  },
  "overrides": [
    {
      "files": ["src/components/*.tsx"],
      "rules": {
        "no-console": "off",
        "typescript/no-explicit-any": "off"
      }
    },
    {
      "files": ["scripts/**/*.mjs"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
