{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "mergeConfidence:all-badges",
        "config:recommended"
    ],
    "prConcurrentLimit": 100,
    "lockFileMaintenance": {
        "enabled": true
    },
    "packageRules": [
        {
            "groupName": "all dependencies",
            "matchPackageNames": [
                "*"
            ]
        },
        {
            "description": "Astro check and typescript-eslint require the TypeScript 6 JavaScript API",
            "matchManagers": ["npm"],
            "matchFileNames": ["docs/package.json", "crates/node-bindings/package.json"],
            "matchDepNames": ["typescript"],
            "allowedVersions": "<6.1.0"
        }
    ]
}
