{
    "name": "modern-colorthief/php-gpu",
    "description": "PHP GPU bindings for modern_colorthief - fast color palette extraction",
    "type": "library",
    "license": "MIT",
    "files": [
        "native/*"
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "pestphp/pest": "^4.0 || ^5.0",
        "squizlabs/php_codesniffer": "^4.0",
        "slevomat/coding-standard": "^8.25"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "archive": {
        "exclude": ["/native"]
    }
}
